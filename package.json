{
  "name": "tab-ai",
  "version": "0.3.0",
  "description": "Every task evolves. Any agent runs it (Codex, OpenCode, Claude Code…); any bot drives it (Feishu, WeCom, DingTalk, WeChat…).",
  "license": "Apache-2.0",
  "author": "tab-ai <dujlmail@gmail.com>",
  "homepage": "https://github.com/dujl/tab-ai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dujl/tab-ai.git"
  },
  "bugs": {
    "url": "https://github.com/dujl/tab-ai/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.map",
    "tab-ai.config.example.json",
    ".env.example",
    "README.md",
    "LICENSE",
    "docs",
    ".github/workflows/ci.yml",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "bin": {
    "tab-ai": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/cli.js",
    "check": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=4 test/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-docs.mjs",
    "test:coverage": "tsx --test --test-concurrency=4 --experimental-test-coverage --test-coverage-include='src/**' test/*.test.ts",
    "verify": "npm run format:check && npm run docs:check && npm run check && npm test && npm run build && npm run docs:check:package",
    "docs:check:package": "npm pack --dry-run --json | node scripts/check-docs.mjs --package"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@inquirer/prompts": "^8.7.4",
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "commander": "^13.1.0",
    "dingtalk-stream": "^2.1.6-beta.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "prettier": "3.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@wecom/cli": "^1.3.4"
  }
}
